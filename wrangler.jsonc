{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twitch-stream-syncer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "routes": [
    {
      "pattern": "worker.norwelab.nl",
      "custom_domain": true
    }
  ]
}
